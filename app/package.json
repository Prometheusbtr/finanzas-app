{
  "name": "finanzas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply finanzas --local",
    "seed:sql": "node scripts/seed.ts ../data/ledger.json ../data/seed.sql",
    "seed:local": "wrangler d1 execute finanzas --local --file=../data/seed.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
